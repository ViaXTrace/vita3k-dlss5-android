diff --git a/vita3k/shaders-builtin/vulkan/render_main_dlss5_free.frag b/vita3k/shaders-builtin/vulkan/render_main_dlss5_free.frag
new file mode 100644
index 0000000..7268106
--- /dev/null
+++ b/vita3k/shaders-builtin/vulkan/render_main_dlss5_free.frag
@@ -0,0 +1,53 @@
+// Vita3K emulator project
+// Free post-processing approximation inspired by the visual goals of DLSS 5.
+//
+// This is not NVIDIA DLSS, does not use NVIDIA code or models, and is designed
+// to run on Android Vulkan devices without a paid SDK or network service.
+
+#version 450
+
+layout(location = 0) in vec2 uv_frag;
+layout(binding = 0) uniform sampler2D fb;
+
+layout(location = 0) out vec3 color_frag;
+
+layout(push_constant) uniform constants {
+    vec2 inv_frame_size;
+} pc;
+
+float luma(vec3 color) {
+    return dot(color, vec3(0.2126, 0.7152, 0.0722));
+}
+
+void main() {
+    vec2 texel = pc.inv_frame_size;
+    vec3 center = texture(fb, uv_frag).rgb;
+
+    vec3 north = texture(fb, uv_frag + vec2(0.0, -texel.y)).rgb;
+    vec3 south = texture(fb, uv_frag + vec2(0.0, texel.y)).rgb;
+    vec3 east = texture(fb, uv_frag + vec2(texel.x, 0.0)).rgb;
+    vec3 west = texture(fb, uv_frag + vec2(-texel.x, 0.0)).rgb;
+    vec3 diagonal = (
+        texture(fb, uv_frag + vec2(-texel.x, -texel.y)).rgb +
+        texture(fb, uv_frag + vec2(texel.x, -texel.y)).rgb +
+        texture(fb, uv_frag + vec2(-texel.x, texel.y)).rgb +
+        texture(fb, uv_frag + vec2(texel.x, texel.y)).rgb
+    ) * 0.25;
+
+    vec3 cross_average = (north + south + east + west) * 0.25;
+    vec3 neighborhood = (cross_average * 0.7) + (diagonal * 0.3);
+    vec3 detail = center - neighborhood;
+
+    float center_luma = luma(center);
+    float neighborhood_luma = luma(neighborhood);
+    float edge_strength = clamp(abs(center_luma - neighborhood_luma) * 4.0, 0.0, 1.0);
+
+    // Keep the pass stable on UI/text edges while adding local detail.
+    vec3 sharpened = center + detail * mix(0.24, 0.08, edge_strength);
+    float local_contrast = clamp((center_luma - neighborhood_luma) * 0.16, -0.08, 0.08);
+    vec3 graded = sharpened + local_contrast;
+
+    // Gentle highlight rolloff keeps the post-process from clipping bright UI.
+    graded = graded / (1.0 + max(graded, vec3(0.0)) * 0.045);
+    color_frag = clamp(graded, 0.0, 1.0);
+}